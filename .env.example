# Leave any of these blank if you prefer configuring them inside the Rotation Setup popup on launch!
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=
MACHINE_ID=
MUSIC_SECTION_ID=1
SERVER_NAME=Plex Server
USER_HANDLE=@you • Plexamp

# Folder containing tautulli.db (optional if uploading/linking tautulli.db in Setup UI)
TAUTULLI_DIR=./cache

# Optional: passcode lock before anyone can view stats or change settings (can also be set in UI)
APP_PASSWORD=

# Optional: monthly recap push (ntfy app on your phone), e.g. https://ntfy.sh/your-rotation-topic
NTFY_URL=
# Optional: link the notification opens, e.g. https://your-server.your-tailnet.ts.net
PUBLIC_URL=
